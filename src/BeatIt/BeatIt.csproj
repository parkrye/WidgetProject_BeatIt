<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\beatit.ico</ApplicationIcon>
    <AssemblyTitle>BeatIt</AssemblyTitle>
    <Product>BeatIt</Product>
    <!-- 올리면 기본 캐릭터/테마를 사용자 폴더에 다시 풀어준다. 새 에셋을 넣었으면 같이 올린다. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <!-- 런타임 포함 여부는 publish.ps1 이 정한다. 여기서 정하면 명령줄 값과 엇갈린다. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    기본 캐릭터 폴더를 통째로 zip 으로 묶어 exe 안에 넣는다.
    파일을 하나씩 리소스로 넣으면 리소스 이름에서 원래 폴더 구조를 되살릴 수 없다.
  -->
  <Target Name="PackCharacters" BeforeTargets="PrepareForBuild">
    <!-- 이 시점엔 obj 하위 폴더가 아직 없을 수 있다. -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\assets\characters"
                  DestinationFile="$(IntermediateOutputPath)characters.zip"
                  Overwrite="true" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\assets\themes"
                  DestinationFile="$(IntermediateOutputPath)themes.zip"
                  Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)characters.zip" LogicalName="BeatIt.characters.zip" />
      <EmbeddedResource Include="$(IntermediateOutputPath)themes.zip" LogicalName="BeatIt.themes.zip" />
    </ItemGroup>
  </Target>

</Project>
