<UserControl x:Class="BeatIt.Controls.ComboDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Opacity="0">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1" />
    </UserControl.RenderTransform>
    <UserControl.RenderTransformOrigin>
        <Point X="0.5" Y="0.5" />
    </UserControl.RenderTransformOrigin>

    <StackPanel HorizontalAlignment="Center">
        <StackPanel.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#000000" Opacity="0.95" />
        </StackPanel.Effect>
        <TextBlock x:Name="CountText"
                   Text="0"
                   FontFamily="Segoe UI Black, Arial Black"
                   FontSize="52"
                   FontWeight="Black"
                   Foreground="White"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="LabelText"
                   Text="COMBO"
                   FontFamily="Segoe UI Black, Arial Black"
                   FontSize="16"
                   FontWeight="Black"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,-10,0,0" />
    </StackPanel>
</UserControl>
