<Window x:Class="BeatIt.Views.CharacterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 관리"
        Width="940"
        Height="640"
        MinWidth="780"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="380" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="ColumnHead">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <Style TargetType="Button" x:Key="Action">
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="폴더 열기" Padding="14,5" Click="OnOpenFolder"
                    ToolTip="캐릭터가 모여 사는 폴더를 탐색기로 연다. 여기서 못 하는 건 직접 하면 된다." />
            <Button DockPanel.Dock="Right" Content="닫기" Width="100" Padding="0,5" IsDefault="True" IsCancel="True" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="14,0" Foreground="#555555"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. 캐릭터 프로필 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="캐릭터" Style="{StaticResource ColumnHead}" />
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="새로 만들기..." Style="{StaticResource Action}" Click="OnCreate"
                            ToolTip="빈 캐릭터를 하나 만든다. idle 칸에 그림을 넣어야 쓸 수 있는 캐릭터가 된다." />
                    <Button x:Name="DuplicateButton" Content="복사해서 만들기..." Style="{StaticResource Action}" Click="OnDuplicate"
                            ToolTip="고른 캐릭터를 통째로 베껴 새 캐릭터를 만든다. 기본 캐릭터를 고치고 싶을 때 이걸 쓴다." />
                    <Button x:Name="RenameButton" Content="이름 바꾸기..." Style="{StaticResource Action}" Click="OnRename"
                            ToolTip="폴더 이름을 바꾼다. 이 캐릭터를 쓰고 있었으면 설정도 같이 따라간다." />
                    <Button x:Name="DeleteButton" Content="지우기" Style="{StaticResource Action}" Click="OnDelete"
                            ToolTip="폴더를 통째로 지운다. 되돌릴 수 없으니 한 번 더 묻는다." />
                    <Button Content="폴더에서 가져오기..." Style="{StaticResource Action}" Click="OnImport"
                            ToolTip="밖에 만들어둔 캐릭터 폴더를 통째로 베껴 온다. 원본은 안 건드린다." />
                </StackPanel>
                <ListBox x:Name="CharacterList" DisplayMemberPath="Display" SelectionChanged="OnCharacterChanged" />
            </DockPanel>

            <!-- 2. 상태별 칸 -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="칸" Style="{StaticResource ColumnHead}" />
                <ListBox x:Name="SlotList" SelectionChanged="OnSlotChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding Slot.Hint}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#888888" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Slot.Label}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#666666" Margin="0,8,0,3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>

            <!-- 3. 그 칸에 든 것 -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" x:Name="SlotHeader" Style="{StaticResource ColumnHead}" />
                <TextBlock DockPanel.Dock="Top" x:Name="SlotHint" TextWrapping="Wrap" Foreground="#555555" Margin="2,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="AddButton" Content="추가..." Width="100" Padding="0,5" Click="OnAddFiles"
                            ToolTip="파일을 골라 이 칸으로 베껴 넣는다. 원본을 옮기거나 지워도 캐릭터는 안 깨진다." />
                    <Button x:Name="ReplaceButton" Content="바꾸기..." Width="100" Padding="0,5" Margin="8,0,0,0" Click="OnReplaceFile"
                            ToolTip="고른 파일 하나를 다른 파일로 갈아 끼운다." />
                    <Button x:Name="RemoveButton" Content="빼기" Width="100" Padding="0,5" Margin="8,0,0,0" Click="OnRemoveFiles"
                            ToolTip="고른 파일을 이 칸에서 지운다. 여러 개를 한꺼번에 고를 수 있다." />
                </StackPanel>
                <ListBox x:Name="FileList" SelectionMode="Extended" SelectionChanged="OnFileSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="104" Margin="2" ToolTip="{Binding Path}">
                                <Border Height="84" Background="#F4F4F6" CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="♪" FontSize="30" Foreground="#9A9AA6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding BadgeVisibility}" />
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
