<Window x:Class="BeatIt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:BeatIt.Controls"
        Title="BeatIt 설정"
        Width="620"
        Height="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ToolTipService.InitialShowDelay="300"
        ToolTipService.ShowDuration="120000"
        ToolTipService.ShowOnDisabled="True">
    <Window.Resources>
        <!-- 설명은 길든 짧든 커서를 올렸을 때만 보여준다. 창에 박아두면 정작 값이 안 보인다. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="400" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 한 탭 안의 줄이 같은 자리에서 시작해야 눈이 안 흔들린다. -->
        <Style TargetType="controls:SliderRow">
            <Setter Property="LabelWidth" Value="150" />
        </Style>

        <!-- 평소엔 접어두는 자리. 자주 안 만지는 값이 위쪽 값을 밀어내면 안 된다. -->
        <Style TargetType="Expander" x:Key="Detail">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Foreground" Value="#444444" />
        </Style>

        <Style TargetType="Button" x:Key="Reset">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Summary">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,8,0,0" />
        </Style>

        <!-- 한 줄의 이름과 조절기가 같은 설명을 쓰도록 여기 한 군데에 적어둔다. -->
        <sys:String x:Key="CharacterHint">쓸 캐릭터를 고른다. 캐릭터는 폴더 하나고, 안에 idle / move / beat / sounds 폴더를 둔다. 대기 중에는 idle 중 하나가 랜덤하게 바뀌고, 움직일 때는 move, 맞을 때는 beat 가 뜬다. move 와 beat 는 그 아래 default / left / right / up / down 으로 한 겹 더 나눌 수 있다. 없는 건 default 로, default 도 없으면 idle 로 대신한다.</sys:String>
        <sys:String x:Key="ManageHint">캐릭터를 만들고, 이름을 바꾸고, 지운다. 그 안에서 상태별로 그림과 소리를 넣고 뺄 수 있다. 장수 제한은 없고 GIF 도 섞어 쓸 수 있다. 넣은 그림과 소리는 창을 닫는 즉시 위젯에 반영된다.</sys:String>
        <sys:String x:Key="ManageThemeHint">테마를 만들고, 이름을 바꾸고, 지운다. 그 안에서 타격 이펙트와 콤보 그림·글꼴을 넣고 뺄 수 있다. 콤보 숫자는 0~9 열 자리가 정해져 있어서 자리를 골라 채운다.</sys:String>
        <sys:String x:Key="ThemeHint">테마 폴더에는 effects / combo 를 둔다. effects 의 그림 중 하나가 때릴 때마다 튀고, combo 에 0~9 그림이 다 있으면 그 그림으로, 없고 폰트 파일(.ttf/.otf)이 있으면 그 폰트로 콤보를 그린다. 둘 다 없으면 기본 글꼴로 그린다.</sys:String>
        <sys:String x:Key="ComboSizeHint">콤보 숫자의 기본 크기. 콤보가 쌓이면 여기서 계단씩 커진다. 숫자 그림을 쓰는 테마에서는 그 그림의 높이가 된다.</sys:String>
        <sys:String x:Key="ComboXHint">콤보 숫자를 기본 자리(캐릭터 머리 위 가운데)에서 가로로 얼마나 밀지. 민 만큼 창도 같이 넓어져서 숫자가 안 잘린다.</sys:String>
        <sys:String x:Key="ComboYHint">콤보 숫자를 기본 자리에서 세로로 얼마나 밀지. 민 만큼 창도 같이 높아진다.</sys:String>
        <sys:String x:Key="ComboGapHint">콤보 숫자 밑변과 캐릭터 머리 사이의 틈. 숫자는 이 자리에 밑변을 붙이고 위로 자라기 때문에, 아무리 커져도 캐릭터를 덮지 않는다.</sys:String>
        <sys:String x:Key="ComboStepHint">콤보 크기와 색이 한 계단 오르는 간격. 기본 50 이면 50, 100, 150... 에서 한 번에 뛰고 그때마다 연출이 터진다. 49 에서 50 으로 넘어가는 게 사건처럼 느껴지라고 계단으로 끊는다.</sys:String>
        <sys:String x:Key="ComboGrowthHint">계단 하나마다 숫자가 커지는 비율. 기본값이면 1000 콤보에서 3배가 된다. 색도 1000 까지 스펙트럼을 다 쓰고, 그 뒤로는 은은한 무지개로 돈다.</sys:String>
        <sys:String x:Key="ComboMaxHint">숫자가 아무리 커져도 넘지 않는 배율. 창은 숫자가 커진 만큼 같이 커지므로, 이게 없으면 화면을 다 먹는다.</sys:String>
        <sys:String x:Key="WidthHint">위젯의 가로 길이. 세로는 지금 떠 있는 그림의 비율을 따라간다. 비율이 다른 그림이 섞여 있으면 나머지는 그 상자 안에 맞춰 들어간다.</sys:String>
        <sys:String x:Key="ComboTimeHint">이 시간 안에 다시 때려야 콤보가 이어진다. 넘기면 처음부터 다시 센다.</sys:String>
        <sys:String x:Key="IdleHint">가만히 있을 때 idle 그림을 갈아 끼우는 간격. 최소와 최대 사이에서 매번 다시 뽑는다. 규칙적이지 않아야 살아있어 보인다.</sys:String>
        <sys:String x:Key="VolumeHint">캐릭터 폴더의 sounds 에 넣어둔 소리 크기.</sys:String>
        <sys:String x:Key="MuteHint">켜면 볼륨과 무관하게 아무 소리도 안 난다.</sys:String>
        <sys:String x:Key="IdleSoundHint">가만히 있을 때 우는 간격. 최소와 최대 사이에서 매번 다시 뽑는다. idle 그림 교체와는 따로 돈다. wav·mp3·wma·m4a 는 그냥 나고, ogg·flac 처럼 코덱이 따로 필요한 형식은 그 코덱이 깔려 있어야 난다. 못 여는 파일은 알아서 빠지니 섞여 있어도 조용해지지 않는다.</sys:String>
        <sys:String x:Key="WanderHint">켜면 이동 영역 안에서 목적지를 골라 걸어가고, 도착하면 잠깐 쉰다. 때리거나 끌면 멈추고, 커서를 올려두면 그동안 멈춰 선다. 위치 잠금이 켜져 있으면 돌아다니지 않는다.</sys:String>
        <sys:String x:Key="AreaHint">어디까지 돌아다닐지. 화면 전체는 모니터를 다 합친 범위, 현재 모니터는 위젯이 지금 올라가 있는 모니터, 작업 영역은 거기서 작업표시줄을 뺀 자리다. 직접 지정을 고르면 화면이 어두워지고, 끌어서 사각형을 그린 뒤 Enter 로 확정한다. 영역 밖에 있어도 끌어내지 않는다. 다음 목적지가 영역 안이라 알아서 걸어 들어온다. 영역은 위젯 창 전체가 들어가는 범위라, 캐릭터는 그린 경계보다 조금 안쪽까지만 간다. 집어던지기를 켜면 던진 게 부딪히는 벽도 이 영역이다.</sys:String>
        <sys:String x:Key="SpeedHint">걷는 속도. 목적지를 새로 고를 때마다 최소와 최대 사이에서 뽑는다. 출발과 도착에서는 여기서 더 느려져 뚜벅뚜벅 걷는 느낌이 난다.</sys:String>
        <sys:String x:Key="RestHint">목적지에 닿은 뒤 쉬는 시간. 최소와 최대 사이에서 매번 다시 뽑는다.</sys:String>
        <sys:String x:Key="HitRestHint">맞은 뒤 다시 걷기까지 멈춰 서 있는 시간. 때리자마자 걸어 나가면 연타가 허공을 때린다.</sys:String>
        <sys:String x:Key="DragRestHint">끌다 놓은 뒤 다시 걷기까지 멈춰 서 있는 시간.</sys:String>
        <sys:String x:Key="ThrowHint">켜면 끌다 놓을 때 그 자리에 서지 않고, 놓은 순간의 속도로 날아간다. 이동 영역 경계에 닿으면 통 하고 튕겨 돌아오고, 느려지면 그 자리에 선다. 위치 잠금이 켜져 있으면 끌 수가 없어서 던지지도 못한다.</sys:String>
        <sys:String x:Key="ThrowScaleHint">놓은 속도를 얼마나 부풀려 던질지. 1 이면 커서가 가던 속도 그대로 날아간다. 살살 뿌려도 시원하게 날아가길 바라면 올린다.</sys:String>
        <sys:String x:Key="ThrowMaxHint">아무리 세게 뿌려도 이 속도를 넘지 않는다. 마우스를 확 튕기면 한 프레임에 화면을 가로지르는 속도가 나오기 때문에 뚜껑을 덮어둔다.</sys:String>
        <sys:String x:Key="ThrowBounceHint">벽에 튕길 때 남는 속도의 비율. 0 이면 벽에 붙어 서고, 1 에 가까울수록 오래 튄다.</sys:String>
        <sys:String x:Key="ThrowFrictionHint">나는 동안 초당 줄어드는 속도의 비율. 클수록 빨리 선다. 0 이면 벽에서 튕기기만 하며 영영 돌아다닌다.</sys:String>
        <sys:String x:Key="ThrowStopHint">이 속도 밑으로 떨어지면 다 왔다고 보고 멈춘다. 너무 낮게 잡으면 눈에 안 보이게 기어가는 동안 창이 계속 움직인다.</sys:String>
        <sys:String x:Key="HitPowerHint">한 대 맞을 때 꾸겨지는 세기. 스프링에 임펄스로 밀어넣기 때문에 연타하면 흔들림이 누적된다.</sys:String>
        <sys:String x:Key="HitTiltHint">한 대 맞을 때 휘청이는 세기. 어느 쪽으로 기울지는 맞을 때마다 랜덤이다.</sys:String>
        <sys:String x:Key="HitGainHint">콤보 한 단계마다 타격이 세지는 비율. 0 이면 몇 콤보든 같은 세기로 맞는다.</sys:String>
        <sys:String x:Key="BeatHoldHint">맞은 그림을 붙들고 있는 시간. 지나면 idle 로 돌아간다. 짧게 잡으면 맞은 표정이 스쳐 지나간다.</sys:String>
        <sys:String x:Key="DragLagHint">끌고 갈 때 몸통이 붙잡은 지점보다 얼마나 뒤처지는지. 0 이면 통째로 뻣뻣하게 따라온다.</sys:String>
        <sys:String x:Key="DragStretchHint">끌려갈 때 늘어나는 한계. 가는 방향으로만 늘어나고 그 직각으로는 홀쭉해진다. 0 이면 안 늘어난다.</sys:String>
        <sys:String x:Key="DragSpringHint">놓았을 때 제자리로 돌아오는 스프링의 세기. 클수록 빨리 잡히고 덜 출렁인다.</sys:String>
        <sys:String x:Key="TopmostHint">끄면 다른 창 뒤로 들어간다.</sys:String>
        <sys:String x:Key="LockHint">켜면 끌어서 옮기지도, 혼자 돌아다니지도 않는다. 때리는 건 그대로 된다.</sys:String>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" Width="90" Padding="0,5" IsDefault="True" Click="OnConfirm"
                    ToolTip="지금 값으로 저장하고 닫는다." />
            <Button Content="취소" Width="90" Padding="0,5" Margin="8,0,0,0" IsCancel="True"
                    ToolTip="열기 전 값으로 되돌리고 닫는다." />
        </StackPanel>

        <TabControl>
            <TabItem Header="캐릭터">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CharacterCombo" Grid.Column="0" DisplayMemberPath="Name"
                                  SelectionChanged="OnCharacterChanged"
                                  ToolTip="{StaticResource CharacterHint}" />
                        <Button Grid.Column="1" Content="캐릭터 관리..." Padding="12,4" Margin="8,0,0,0"
                                Click="OnManageCharacters" ToolTip="{StaticResource ManageHint}" />
                        <Button Grid.Column="2" Content="폴더 열기" Padding="12,4" Margin="6,0,0,0"
                                Click="OnOpenCharacterFolder"
                                ToolTip="캐릭터가 모여 사는 폴더를 탐색기로 연다." />
                    </Grid>
                    <TextBlock x:Name="CharacterSummary" Style="{StaticResource Summary}"
                               ToolTip="{StaticResource CharacterHint}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="테마">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="0" DisplayMemberPath="Name"
                                      SelectionChanged="OnThemeChanged" ToolTip="{StaticResource ThemeHint}" />
                            <Button Grid.Column="1" Content="테마 관리..." Padding="12,4" Margin="8,0,0,0"
                                    Click="OnManageThemes" ToolTip="{StaticResource ManageThemeHint}" />
                            <Button Grid.Column="2" Content="폴더 열기" Padding="12,4" Margin="6,0,0,0"
                                    Click="OnOpenThemeFolder"
                                    ToolTip="테마가 모여 사는 폴더를 탐색기로 연다." />
                        </Grid>
                        <TextBlock x:Name="ThemeSummary" Style="{StaticResource Summary}"
                                   ToolTip="{StaticResource ThemeHint}" />

                        <CheckBox x:Name="EffectsCheck" Content="타격 이펙트 띄우기" Margin="2,12,0,0" Click="OnValueToggled"
                                  ToolTip="끄면 때려도 이펙트가 안 뜬다. 테마의 effects 폴더가 비어 있어도 안 뜬다." />

                        <controls:SliderRow x:Name="ComboSizeRow" Label="콤보 숫자 크기" Minimum="16" Maximum="160" Step="2"
                                            Unit="px" ValueChanged="OnRowChanged"
                                            ToolTip="{StaticResource ComboSizeHint}" />
                        <controls:SliderRow x:Name="ComboXRow" Label="콤보 가로 위치" Minimum="-200" Maximum="200" Step="2"
                                            Unit="px" ValueChanged="OnRowChanged"
                                            ToolTip="{StaticResource ComboXHint}" />
                        <controls:SliderRow x:Name="ComboYRow" Label="콤보 세로 위치" Minimum="-200" Maximum="200" Step="2"
                                            Unit="px" ValueChanged="OnRowChanged"
                                            ToolTip="{StaticResource ComboYHint}" />

                        <Expander Header="콤보가 자라는 법" Style="{StaticResource Detail}">
                            <StackPanel Margin="0,4,0,0">
                                <controls:SliderRow x:Name="ComboGapRow" Label="머리 위 틈" Minimum="0" Maximum="120" Step="1"
                                                    Unit="px" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ComboGapHint}" />
                                <controls:SliderRow x:Name="ComboMilestoneRow" Label="한 계단 간격" Minimum="5" Maximum="200" Step="5"
                                                    Unit="콤보" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ComboStepHint}" />
                                <controls:SliderRow x:Name="ComboGrowthRow" Label="계단당 커지는 폭" Minimum="0" Maximum="50" Step="1"
                                                    Unit="%" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ComboGrowthHint}" />
                                <controls:SliderRow x:Name="ComboMaxScaleRow" Label="최대 배율" Minimum="1" Maximum="8" Step="0.1"
                                                    Unit="배" Decimals="1" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ComboMaxHint}" />
                                <Button Content="기본값으로" Style="{StaticResource Reset}" Click="OnResetCombo"
                                        ToolTip="이 칸의 값만 처음 값으로 되돌린다." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="감각">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <controls:SliderRow x:Name="WidthRow" Label="위젯 가로 크기" Minimum="80" Maximum="640" Step="5"
                                            Unit="px" ValueChanged="OnRowChanged"
                                            ToolTip="{StaticResource WidthHint}" />
                        <controls:SliderRow x:Name="ComboTimeoutRow" Label="콤보 유지 시간" Minimum="300" Maximum="4000" Step="50"
                                            Unit="ms" ValueChanged="OnRowChanged"
                                            ToolTip="{StaticResource ComboTimeHint}" />
                        <controls:SliderRow x:Name="IdleMinRow" Label="idle 교체 최소" Minimum="300" Maximum="15000" Step="100"
                                            Unit="ms" ValueChanged="OnPairChanged"
                                            ToolTip="{StaticResource IdleHint}" />
                        <controls:SliderRow x:Name="IdleMaxRow" Label="idle 교체 최대" Minimum="300" Maximum="15000" Step="100"
                                            Unit="ms" ValueChanged="OnPairChanged"
                                            ToolTip="{StaticResource IdleHint}" />

                        <Expander Header="타격 상세 설정" Style="{StaticResource Detail}">
                            <StackPanel Margin="0,4,0,0">
                                <controls:SliderRow x:Name="HitPowerRow" Label="꾸겨지는 세기" Minimum="0" Maximum="25" Step="0.5"
                                                    Decimals="1" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource HitPowerHint}" />
                                <controls:SliderRow x:Name="HitTiltRow" Label="휘청이는 세기" Minimum="0" Maximum="500" Step="10"
                                                    ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource HitTiltHint}" />
                                <controls:SliderRow x:Name="HitGainRow" Label="콤보당 증가폭" Minimum="0" Maximum="30" Step="1"
                                                    Unit="%" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource HitGainHint}" />
                                <controls:SliderRow x:Name="BeatHoldRow" Label="beat 유지 시간" Minimum="100" Maximum="3000" Step="50"
                                                    Unit="ms" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource BeatHoldHint}" />
                                <Button Content="기본값으로" Style="{StaticResource Reset}" Click="OnResetHit"
                                        ToolTip="이 칸의 값만 처음 값으로 되돌린다." />
                            </StackPanel>
                        </Expander>

                        <Expander Header="드래그 상세 설정" Style="{StaticResource Detail}">
                            <StackPanel Margin="0,4,0,0">
                                <controls:SliderRow x:Name="DragLagRow" Label="뒤처지는 양" Minimum="0" Maximum="2" Step="0.05"
                                                    Decimals="2" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource DragLagHint}" />
                                <controls:SliderRow x:Name="DragStretchRow" Label="늘어나는 한계" Minimum="0" Maximum="1" Step="0.05"
                                                    Decimals="2" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource DragStretchHint}" />
                                <controls:SliderRow x:Name="DragSpringRow" Label="복귀 스프링 세기" Minimum="10" Maximum="400" Step="5"
                                                    ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource DragSpringHint}" />
                                <Button Content="기본값으로" Style="{StaticResource Reset}" Click="OnResetDrag"
                                        ToolTip="이 칸의 값만 처음 값으로 되돌린다." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="소리">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <controls:SliderRow x:Name="VolumeRow" Label="볼륨" Minimum="0" Maximum="100" Step="1"
                                            Unit="%" ValueChanged="OnRowChanged"
                                            ToolTip="{StaticResource VolumeHint}" />
                        <CheckBox x:Name="MuteCheck" Content="음소거" Margin="2,12,0,0"
                                  Click="OnValueToggled" ToolTip="{StaticResource MuteHint}" />
                        <controls:SliderRow x:Name="IdleSoundMinRow" Label="대기 소리 최소" Minimum="1000" Maximum="120000" Step="1000"
                                            Unit="ms" ValueChanged="OnPairChanged"
                                            ToolTip="{StaticResource IdleSoundHint}" />
                        <controls:SliderRow x:Name="IdleSoundMaxRow" Label="대기 소리 최대" Minimum="1000" Maximum="120000" Step="1000"
                                            Unit="ms" ValueChanged="OnPairChanged"
                                            ToolTip="{StaticResource IdleSoundHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="동작">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <CheckBox x:Name="WanderCheck" Content="혼자 돌아다니기 (때리거나 끌면 잠깐 멈춘다)"
                                  Click="OnWanderToggled" ToolTip="{StaticResource WanderHint}" />

                        <Grid x:Name="WanderAreaRow" Margin="20,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="이동 영역" VerticalAlignment="Center" Margin="0,0,10,0"
                                       ToolTip="{StaticResource AreaHint}" />
                            <ComboBox x:Name="WanderAreaCombo" Grid.Column="1" SelectionChanged="OnWanderAreaChanged"
                                      ToolTip="{StaticResource AreaHint}" />
                            <Button x:Name="PickAreaButton" Grid.Column="2" Content="다시 그리기" Padding="12,4" Margin="6,0,0,0"
                                    Click="OnPickArea"
                                    ToolTip="영역을 다시 그린다. 화면이 어두워지면 끌어서 사각형을 그리고 Enter 로 확정, Esc 로 취소한다. 40x40 보다 작게 그리면 실수로 클릭한 걸로 본다." />
                        </Grid>
                        <TextBlock x:Name="WanderAreaSummary" Style="{StaticResource Summary}" Margin="20,8,0,0"
                                   ToolTip="{StaticResource AreaHint}" />

                        <Expander Header="이동 상세 설정" Style="{StaticResource Detail}">
                            <StackPanel Margin="0,4,0,0">
                                <controls:SliderRow x:Name="SpeedMinRow" Label="이동 속도 최소" Minimum="10" Maximum="600" Step="5"
                                                    Unit="px/s" ValueChanged="OnPairChanged"
                                                    ToolTip="{StaticResource SpeedHint}" />
                                <controls:SliderRow x:Name="SpeedMaxRow" Label="이동 속도 최대" Minimum="10" Maximum="600" Step="5"
                                                    Unit="px/s" ValueChanged="OnPairChanged"
                                                    ToolTip="{StaticResource SpeedHint}" />
                                <controls:SliderRow x:Name="RestMinRow" Label="쉬는 시간 최소" Minimum="0" Maximum="30000" Step="100"
                                                    Unit="ms" ValueChanged="OnPairChanged"
                                                    ToolTip="{StaticResource RestHint}" />
                                <controls:SliderRow x:Name="RestMaxRow" Label="쉬는 시간 최대" Minimum="0" Maximum="30000" Step="100"
                                                    Unit="ms" ValueChanged="OnPairChanged"
                                                    ToolTip="{StaticResource RestHint}" />
                                <controls:SliderRow x:Name="HitRestRow" Label="맞은 뒤 멈춤" Minimum="0" Maximum="10000" Step="100"
                                                    Unit="ms" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource HitRestHint}" />
                                <controls:SliderRow x:Name="DragRestRow" Label="놓은 뒤 멈춤" Minimum="0" Maximum="10000" Step="100"
                                                    Unit="ms" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource DragRestHint}" />
                                <Button Content="기본값으로" Style="{StaticResource Reset}" Click="OnResetMotion"
                                        ToolTip="이 칸의 값만 처음 값으로 되돌린다." />
                            </StackPanel>
                        </Expander>

                        <CheckBox x:Name="ThrowCheck" Content="잡아서 집어던지기 (놓으면 날아가 벽에 튕긴다)" Margin="0,16,0,0"
                                  Click="OnThrowToggled" ToolTip="{StaticResource ThrowHint}" />

                        <Expander x:Name="ThrowDetail" Header="던지기 상세 설정" Style="{StaticResource Detail}">
                            <StackPanel Margin="0,4,0,0">
                                <controls:SliderRow x:Name="ThrowScaleRow" Label="던지는 세기" Minimum="0.1" Maximum="4" Step="0.1"
                                                    Unit="배" Decimals="1" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ThrowScaleHint}" />
                                <controls:SliderRow x:Name="ThrowMaxSpeedRow" Label="최대 속도" Minimum="200" Maximum="8000" Step="100"
                                                    Unit="px/s" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ThrowMaxHint}" />
                                <controls:SliderRow x:Name="ThrowBounceRow" Label="반발계수" Minimum="0" Maximum="1" Step="0.05"
                                                    Decimals="2" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ThrowBounceHint}" />
                                <controls:SliderRow x:Name="ThrowFrictionRow" Label="마찰" Minimum="0" Maximum="8" Step="0.1"
                                                    Decimals="1" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ThrowFrictionHint}" />
                                <controls:SliderRow x:Name="ThrowStopRow" Label="멈추는 속도" Minimum="5" Maximum="300" Step="5"
                                                    Unit="px/s" ValueChanged="OnRowChanged"
                                                    ToolTip="{StaticResource ThrowStopHint}" />
                                <Button Content="기본값으로" Style="{StaticResource Reset}" Click="OnResetThrow"
                                        ToolTip="이 칸의 값만 처음 값으로 되돌린다." />
                            </StackPanel>
                        </Expander>

                        <CheckBox x:Name="TopmostCheck" Content="항상 위에" Margin="0,16,0,0" Click="OnValueToggled"
                                  ToolTip="{StaticResource TopmostHint}" />
                        <CheckBox x:Name="LockCheck" Content="위치 잠금 (끌어서 옮기기와 돌아다니기를 막는다)" Margin="0,10,0,0"
                                  Click="OnValueToggled" ToolTip="{StaticResource LockHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
