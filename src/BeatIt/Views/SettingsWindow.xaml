<Window x:Class="BeatIt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeatIt 설정"
        Width="560"
        Height="470"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,10,0" />
        </Style>
        <Style TargetType="Slider" x:Key="Row">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style TargetType="TextBlock" x:Key="RowValue">
            <Setter Property="Width" Value="76" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style TargetType="Border" x:Key="Hint">
            <Setter Property="Background" Value="#F4F4F6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style TargetType="Grid" x:Key="Picker">
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" Width="90" Padding="0,5" IsDefault="True" Click="OnConfirm" />
            <Button Content="취소" Width="90" Padding="0,5" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <TabItem Header="캐릭터">
                <StackPanel Margin="14">
                    <Grid Style="{StaticResource Picker}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CharacterCombo" Grid.Column="0" DisplayMemberPath="Name" SelectionChanged="OnCharacterChanged" />
                        <Button Grid.Column="1" Content="폴더 추가..." Padding="12,4" Margin="8,0,0,0" Click="OnAddCharacter" />
                        <Button Grid.Column="2" Content="폴더 열기" Padding="12,4" Margin="6,0,0,0" Click="OnOpenCharacterFolder" />
                    </Grid>
                    <TextBlock x:Name="CharacterSummary" Foreground="#555555" Margin="2,8,0,0" />

                    <Border Style="{StaticResource Hint}">
                        <TextBlock TextWrapping="Wrap" Foreground="#444444">
                            캐릭터는 폴더 하나다. 안에 <Run FontWeight="Bold">idle</Run> / <Run FontWeight="Bold">move</Run> / <Run FontWeight="Bold">beat</Run> 폴더를 두고 이미지를 넣는다.<LineBreak />
                            대기 중에는 idle 중 하나가 랜덤하게 바뀌고, 끌고 갈 때는 move, 맞을 때는 beat 가 뜬다.<LineBreak />
                            move 나 beat 가 없으면 idle 로 대신한다. 하위 폴더 없이 이미지만 넣으면 단일 이미지 캐릭터가 된다.<LineBreak />
                            장수 제한은 없고 GIF 도 섞어 쓸 수 있다.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="테마">
                <StackPanel Margin="14">
                    <Grid Style="{StaticResource Picker}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="0" DisplayMemberPath="Name" SelectionChanged="OnThemeChanged" />
                        <Button Grid.Column="1" Content="폴더 추가..." Padding="12,4" Margin="8,0,0,0" Click="OnAddTheme" />
                        <Button Grid.Column="2" Content="폴더 열기" Padding="12,4" Margin="6,0,0,0" Click="OnOpenThemeFolder" />
                    </Grid>
                    <TextBlock x:Name="ThemeSummary" Foreground="#555555" Margin="2,8,0,0" />

                    <CheckBox x:Name="EffectsCheck" Content="타격 이펙트 띄우기" Margin="2,12,0,0" Click="OnValueToggled" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="콤보 숫자 크기" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="ComboSizeSlider" Grid.Row="0" Grid.Column="1" Minimum="16" Maximum="160" TickFrequency="2" Style="{StaticResource Row}" ValueChanged="OnValueChanged" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ElementName=ComboSizeSlider, Path=Value, StringFormat={}{0:F0} px}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="콤보 가로 위치" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="ComboXSlider" Grid.Row="1" Grid.Column="1" Minimum="-200" Maximum="200" TickFrequency="2" Style="{StaticResource Row}" ValueChanged="OnValueChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ElementName=ComboXSlider, Path=Value, StringFormat={}{0:F0} px}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="콤보 세로 위치" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="ComboYSlider" Grid.Row="2" Grid.Column="1" Minimum="-200" Maximum="200" TickFrequency="2" Style="{StaticResource Row}" ValueChanged="OnValueChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ElementName=ComboYSlider, Path=Value, StringFormat={}{0:F0} px}" />
                    </Grid>

                    <Border Style="{StaticResource Hint}">
                        <TextBlock TextWrapping="Wrap" Foreground="#444444">
                            테마 폴더에는 <Run FontWeight="Bold">effects</Run> / <Run FontWeight="Bold">combo</Run> 를 둔다.<LineBreak />
                            effects 의 그림 중 하나가 때릴 때마다 튀고, combo 에 0~9 그림이 다 있으면 그 그림으로,
                            없고 폰트 파일(.ttf/.otf)이 있으면 그 폰트로 콤보를 그린다. 둘 다 없으면 기본 글꼴.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="감각">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="위젯 가로 크기" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="WidthSlider" Grid.Row="0" Grid.Column="1" Minimum="80" Maximum="640" TickFrequency="5" Style="{StaticResource Row}" ValueChanged="OnValueChanged" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat={}{0:F0} px}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="콤보 유지 시간" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="ComboSlider" Grid.Row="1" Grid.Column="1" Minimum="300" Maximum="4000" TickFrequency="50" Style="{StaticResource Row}" ValueChanged="OnValueChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ElementName=ComboSlider, Path=Value, StringFormat={}{0:F0} ms}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="idle 교체 최소" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="IdleMinSlider" Grid.Row="2" Grid.Column="1" Minimum="300" Maximum="15000" TickFrequency="100" Style="{StaticResource Row}" ValueChanged="OnIdleMinChanged" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ElementName=IdleMinSlider, Path=Value, StringFormat={}{0:F0} ms}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="idle 교체 최대" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="IdleMaxSlider" Grid.Row="3" Grid.Column="1" Minimum="300" Maximum="15000" TickFrequency="100" Style="{StaticResource Row}" ValueChanged="OnIdleMaxChanged" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ElementName=IdleMaxSlider, Path=Value, StringFormat={}{0:F0} ms}" />

                    <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Hint}" VerticalAlignment="Top">
                        <TextBlock TextWrapping="Wrap" Foreground="#444444">
                            콤보 유지 시간 안에 다시 때려야 콤보가 이어진다.<LineBreak />
                            idle 교체 간격은 최소와 최대 사이에서 매번 다시 뽑는다. 규칙적이지 않아야 살아있어 보인다.
                        </TextBlock>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="동작">
                <StackPanel Margin="14">
                    <CheckBox x:Name="WanderCheck" Content="혼자 돌아다니기 (때리거나 끌면 잠깐 멈춘다)" Click="OnValueToggled" />
                    <CheckBox x:Name="TopmostCheck" Content="항상 위에" Margin="0,10,0,0" Click="OnValueToggled" />
                    <CheckBox x:Name="LockCheck" Content="위치 잠금 (끌어서 옮기기와 돌아다니기를 막는다)" Margin="0,10,0,0" Click="OnValueToggled" />

                    <Border Style="{StaticResource Hint}">
                        <TextBlock TextWrapping="Wrap" Foreground="#444444">
                            돌아다니기를 켜면 화면 아무 데나 목적지를 골라 걸어가고, 도착하면 잠깐 쉰다.<LineBreak />
                            위치 잠금이 켜져 있으면 돌아다니지 않는다.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
